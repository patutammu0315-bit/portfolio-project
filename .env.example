# GEMINI_API_KEY: Required for Gemini AI API calls (Server-side secret)
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="https://rajeshportfolio-theta.vercel.app/"

# Server-Side Email Configuration for Contact Form (Access via process.env.EMAIL_USER)
EMAIL_USER=
EMAIL_PASSWORD=
CONTACT_RECEIVER_EMAIL=demigodgamingawn@gmail.com

# Client-Side Public Environment Variables (Access in Vite/React via import.meta.env.VITE_*)
# Note: Variables MUST start with VITE_ to be exposed to the browser client.
# VITE_PUBLIC_API_KEY=your_public_key_here
# VITE_APP_NAME="Rajesh Portfolio"

